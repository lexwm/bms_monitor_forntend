{
  "openapi": "3.1.0",
  "info": {
    "title": "BMS Monitor API",
    "version": "0.2.0",
    "description": "Read-only LAN telemetry. UTC reception time is not measurement time. Additive response fields are permitted; known fields remain strictly validated.",
    "license": {
      "name": "Private",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8088",
      "description": "Local development only"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Battery",
      "description": "Battery reception state"
    }
  ],
  "paths": {
    "/api/v1/battery/latest": {
      "get": {
        "operationId": "getLatestBattery",
        "tags": [
          "Battery"
        ],
        "summary": "Read the latest measurement",
        "description": "No query parameters. Latest measurement includes invalid records; it never silently falls back to last_valid. Stale when age > 20 seconds. No cache.",
        "responses": {
          "200": {
            "description": "Latest measurement, including stale or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestResponse"
                }
              }
            }
          },
          "404": {
            "description": "No measurements or unknown resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unknown query parameters are rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database or source data unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/telemetry/records": {
      "post": {
        "operationId": "ingestRecord",
        "tags": [
          "Battery"
        ],
        "summary": "Persist one source record; no collector implementation",
        "description": "Maximum 65536 bytes, JSON depth32. Source received_at is immutable, <=6 fractional digits and not future. Same identity and content returns200, conflict409. Only acknowledged after commit. Record object retained as semantic JSON.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRecord"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "HTTP 201: successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "200": {
            "description": "HTTP 200: successful result",
            "content": {
              "application/json": {
                "schema": {
