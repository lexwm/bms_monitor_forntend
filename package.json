{
  "name": "bms-monitor-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "generate:api": "node scripts/generate-api.mjs",
    "check:generated": "node scripts/generate-api.mjs --check",
    "test": "vitest run tests",
    "test:contract": "node scripts/check-http.mjs",
    "lint:contract": "redocly lint contracts/openapi.json",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@redocly/cli": "2.79.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
